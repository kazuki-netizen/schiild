{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schiild-demo-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://schiild.app,https://schiild.pickleballnavi.jp",
    "IMAGE_BACKEND": "durable-sqlite",
    "PUBLIC_ORIGIN": "https://schiild.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ATELIERS",
        "class_name": "AtelierDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AtelierDirectory"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": ".wrangler/cloudflare-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "schiild.app",
      "custom_domain": true
    },
    {
      "pattern": "www.schiild.app",
      "custom_domain": true
    }
  ]
}
